# Frontend/API settings
VITE_DEFAULT_SOURCE=auto
VITE_API_TIMEOUT_MS=300000
VITE_REFRESH_TIMEOUT_MS=600000
VITE_API_RETRY_COUNT=1

# Backend settings
PORT=8787
SCHOOL_DATA_PATH=./school_data.csv
ACADEMIC_YEAR_START=2025-04-01
ACADEMIC_YEAR_END=2026-03-31
LIVE_CACHE_TTL_HOURS=12

# Paste request headers from your working scraper/browser session.
# Example: {"User-Agent":"...","Authorization":"Bearer ..."}
MNE_API_HEADERS_JSON={}
MNE_API_BASE_URL=https://mne.seld.gos.pk/Services/api
MNE_API_TIMEOUT_MS=30000
MNE_API_RETRY_COUNT=2
MNE_API_CONCURRENCY=8
# Optional assignment user ID when using Users/AssignedSchoolStatus/{userId}/{year}
MNE_API_USERID=
# Optional CSV path containing monitor user IDs / names for AssignedSchoolStatus
MNE_API_USERIDS_CSV_PATH=./public/MA_userIds.csv
# Assignment source for monitor assignment PDF
MNE_API_ASSIGNMENTS_ENDPOINT=Users/AssignedSchoolStatus/{userId}/{year}
# Optional: leave empty unless you explicitly want a secondary endpoint.
MNE_API_ASSIGNMENTS_FALLBACK_ENDPOINT=
# Keep false to allow dashboard/report load with partial data when a few calls timeout.
MNE_API_FAIL_ON_PARTIAL=false
