# Backend settings
PORT=8787
SCHOOL_DATA_PATH=./school_data.csv
ACADEMIC_YEAR_START=2025-04-01
ACADEMIC_YEAR_END=2026-03-31

# ─── REQUIRED FOR LIVE DATA ───────────────────────────────────────────────────
# Paste the request headers from your browser/scraper session as a JSON object.
# Steps:
#   1. Log in to https://mne.seld.gos.pk in your browser
#   2. Open DevTools → Network tab → click any /api/ request
#   3. Copy the Request Headers as a JSON object and paste below
#   4. Restart the dev server:  npm run dev
#
# Example:
#   MNE_API_HEADERS_JSON={"Authorization":"Bearer YOUR_TOKEN","Cookie":"...","User-Agent":"..."}
MNE_API_HEADERS_JSON={"Accept":"application/json, text/plain, */*","x-apikey":"Write_API_key_here","User-Agent":"Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36"}

MNE_API_BASE_URL=https://mne.seld.gos.pk/Services/api
MNE_API_TIMEOUT_MS=30000
MNE_API_RETRY_COUNT=2
MNE_API_CONCURRENCY=8
MNE_API_USERIDS=2180,2161,2199,2191
MNE_API_USER_NAMES=Abdul Wahab,Ali Hyder Baloch,Naveed Raza Khan Nizamani,Ameer Ahmed Khoso
MNE_API_USERIDS_CSV_PATH=./public/MA_userIds.csv
MNE_API_ASSIGNMENTS_ENDPOINT=Users/AssignedSchoolStatus/{userId}/{year}
MNE_API_ASSIGNMENTS_FALLBACK_ENDPOINT=MonitoringCalendar/GetPlannedVisitsData
MNE_API_FAIL_ON_PARTIAL=false
MNE_API_FAIL_ON_PARTIAL_MIN_FAILED=25
MNE_API_FAIL_ON_PARTIAL_MIN_RATE=0.02
VITE_API_TIMEOUT_MS=300000
VITE_REFRESH_TIMEOUT_MS=600000
VITE_API_RETRY_COUNT=1
